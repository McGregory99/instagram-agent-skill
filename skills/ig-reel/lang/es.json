  "viewer_re": "(?i)\\b(?:t[uú]|te|ti|tus|contigo|vosotr[oa]s|os|vuestr[oa]s?)\\b|\\bsi\\s+(?!no\\b)[a-záéíóúñ]+(?:as|es)\\b|\\b(?:sabes|quieres|tienes|puedes|haces|programas|usas|necesitas|buscas|eres|estás|vas|sigues|crees|piensas|cobras|ganas|pierdes|cometes|llevas|trabajas|aprendes|construyes|vendes)\\b",
