{
  "lang": "es",
  "note": "Spanish (Spain, tu-form) profile for hookscore.py --lang es. Same five checks as English, with Spanish vocabulary. The word lists are heuristics written for spoken castellano, not a trained model: no published study of Spanish hook performance survived verification, and the only sourced rule is that greeting and filler openers ('Hola chicos', 'Bueno...') are weak. Spanish drops subject pronouns, so ADDRESS also looks at second-person verb forms ('Si programas...'), not only at 'tu' and 'te'. Number words are kept out of any stopword list on purpose: 'dos', 'tres' and 'mil' are exactly the concrete markers SPECIFICITY looks for.",
  "word_re": "[^\\W_][\\w$%€'’-]*|[$€]\\s?\\d[\\d.]*",
  "thousands_sep": ".",
  "number_re": "\\d[\\d.]*(?:,\\d+)?\\s?€|[$€]\\s?\\d[\\d.]*(?:,\\d+)?|\\b\\d[\\d.]*(?:,\\d+)?\\s?(?:%|k\\b|x\\b|h\\b|horas?\\b|min\\b|minutos?\\b|d[ií]as?\\b|semanas?\\b|mes(?:es)?\\b|años?\\b)?",
  "proper_re": "(?<!^)(?<![¿¡])\\b[A-ZÁÉÍÓÚÑ][a-záéíóúñü]{2,}\\b",
  "price_re": "[$€]\\s?\\d|\\d\\s?€|\\d\\s?euros?\\b",
  "syllables_per_second": 5.2,
  "spoken_numbers": [
    "cero", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve",
