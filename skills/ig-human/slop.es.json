  "structures": [
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno es (?:solo|sólo|simplemente) [^.!?\\n]{2,60}[,.;] es\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Di lo único que quieres decir. Borra la mitad que prepara el giro."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo)\\b[^.!?\\n]{2,80}\\bsino (?:que )?también\\b",
      "name": "\"No solo X sino también Y\"",
      "fix": "Pártelo en dos frases o quita la mitad más floja."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno (?:se trata|va) (?:solo |sólo )?de [^.!?\\n]{2,60}[,.;!] (?:se trata|va) de\\b",
      "name": "\"No se trata de X, se trata de Y\"",
      "fix": "Empieza por Y. El giro es lo que delata."
    },
    {
      "id": "el-resultado",
      "regex": "(?i)^\\s*¿(?:el resultado|lo mejor|la clave|el truco|lo peor|el problema)\\?\\s*$",
      "name": "Línea con pregunta retórica de dos palabras (\"¿El resultado?\")",
      "fix": "Respóndela en la misma frase en vez de escenificar la revelación."
    },
    {
      "id": "lo-que-aprendi",
      "regex": "(?i)\\b(?:esto es|aquí va|te cuento) lo que (?:aprendí|he aprendido|aprendimos|hemos aprendido)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+ [ye] \\w+\\.",
      "name": "Tríada (regla de tres)",
      "fix": "Dos elementos o cuatro. El tres es el ritmo por defecto del modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / bombilla / chispas / diana",
      "fix": "Un emoji como mucho, y que no sea uno de estos cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5+)",
      "fix": "Tres hashtags. El muro ya no da alcance."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bcomo (?:un )?modelo de lenguaje\\b|\\bsoy una (?:ia|inteligencia artificial)\\b|\\bcomo (?:una )?(?:ia|inteligencia artificial),? no (?:puedo|tengo)\\b",
      "name": "El modelo hablando de sí mismo",
      "fix": "Borra la frase."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|para resumir|resumiendo)\\b",
      "name": "Apertura de cierre de redacción (\"En resumen,\")",
      "fix": "Un post no necesita párrafo de conclusión."
    },
    {
      "id": "engagement-bait",
      "regex": "(?im)¿(?:y tú,? )?(?:qué opinas|qué piensas|estás de acuerdo|me equivoco)\\?\\s*$|¿quién más\\b",
      "name": "Pregunta de interacción de manual",
      "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo concreto que acabas de contar."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*¡?(?:para|deja) de (?:hacer )?scroll\\b|^\\s*¡?no hagas scroll\\b|^\\s*¡?espera,? no (?:hagas scroll|pases)\\b",
      "name": "Apertura \"Deja de hacer scroll\"",
      "fix": "Lo que para el scroll tiene que ser la afirmación misma. Pedir atención delata que no te la has ganado."
    },
    {
      "id": "en-este-video",
      "regex": "(?i)\\b(?:en (?:este|el) (?:v[ií]deo|reel|post)(?: de hoy)?,? (?:te (?:voy a|enseño|explico|cuento)|vamos a)|hoy te voy a (?:enseñar|explicar|mostrar)|te voy a (?:enseñar|mostrar) cómo)\\b",
      "name": "Preámbulo de vídeo (\"en este vídeo te voy a enseñar\")",
      "fix": "Bórralo y empieza por lo que importa. Los dos primeros segundos deciden el reel."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista con emojis como viñetas",
      "fix": "Usa un guion o un salto de línea. La viñeta con emoji es lo que más huele a plantilla."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{3,}\\b){2,}",
      "name": "Tres o más palabras en mayúsculas seguidas",
      "fix": "Las mayúsculas son volumen, no subrayado. Una palabra, como mucho."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)\\b(?:sígueme para más|sigueme para mas|etiqueta a (?:alguien|un amigo|una amiga)|menciona a alguien|dale like si|dale doble tap|comparte esto si|comenta si)\\b",
      "name": "Petición de follow o etiqueta de manual",
      "fix": "Pide la única acción que este post se ha ganado. La petición genérica enseña a ignorarlas todas."
    },
    {
      "id": "hype",
      "regex": "(?i)¿(?:estás |estáis )?list[oa]s? para\\b|¡vamos allá!",
      "name": "Arenga de manual (\"¿Listo para...?\", \"¡Vamos allá!\")",
      "fix": "Quita la arenga y entra directamente en el contenido."
    }
